{
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/guide", "destination": "/guide/", "permanent": true },
    { "source": "/guide/index.html", "destination": "/guide/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(svg|images)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
